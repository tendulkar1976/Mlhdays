# Supabase PostgreSQL Connection Strings
# Mode: Transaction Pooler (Port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Mode: Session Pooler / Direct (Port 5432) for DIRECT_URL (used for migrations and schema push)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Google Gemini API Key (Server-side ONLY; strictly NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY="your-server-side-gemini-api-key-here"

# Environment
NODE_ENV="development"
