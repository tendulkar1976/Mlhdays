# GEMINI API CONFIGURATION (MANDATORY SERVER-SIDE SECRET)
# Never prefix with NEXT_PUBLIC_ or commit actual key to git
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# TAX RULES CONFIGURATION
TAX_RULE_VERSION_DEFAULT=FY2025_26_AY2026_27

# MEMBER 1 (DETERMINISTIC TAX ENGINE) BACKEND URL
MEMBER1_TAX_ENGINE_URL=http://localhost:3000

# MEMBER 3 (FRONTEND) URL
MEMBER3_FRONTEND_URL=http://localhost:3001

# MEMBER 2 (GEMINI AI & DOCUMENT BACKEND) PORT
PORT=3002
NODE_ENV=development
