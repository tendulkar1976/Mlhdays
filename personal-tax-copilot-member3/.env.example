# ==============================================================================
# AI-Powered Personal Tax Copilot — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-VISIBLE VARIABLES (Exposed to the browser via Next.js)
# ------------------------------------------------------------------------------

# Controls whether the frontend uses the contract-compliant mock adapter (true)
# or connects to the live backend API endpoints (false).
# Default: true (for independent frontend testing and demos)
NEXT_PUBLIC_ENABLE_MOCKS=true

# Base URL for the live backend API (Member 1 tax engine & Member 2 AI orchestrator)
# Ignored when NEXT_PUBLIC_ENABLE_MOCKS=true
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Target Statutory Period & Assessment Year (Display only)
NEXT_PUBLIC_ASSESSMENT_YEAR=AY 2026-27
NEXT_PUBLIC_TAX_PERIOD=FY 2025-26


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (STRICTLY PRIVATE — NEVER EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# WARNING: NEVER prefix these variables with NEXT_PUBLIC_!
# They are accessed exclusively by server-side API routes and server actions.

# Google Gemini API Key for server-side RAG and Copilot orchestration (Member 2)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection String (Server-side ORM)
DATABASE_URL=postgresql://user:password@localhost:5432/taxcopilot?schema=public

# Node Environment
NODE_ENV=production
PORT=3000